APP_NAME=LAMAA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamaa
DB_USERNAME=root
DB_PASSWORD=

# Default admin account created by `php artisan db:seed`.
ADMIN_PHONE=0500000000
ADMIN_PASSWORD=change-this-before-seeding

# Online payment via Moyasar (https://moyasar.com) — Saudi gateway, supports mada/Visa/
# Mastercard/Apple Pay. Sign up, verify your business, then paste both keys from your
# Moyasar dashboard here. Leave blank to keep online payment disabled.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# SMS via Msegat (https://msegat.com) — Saudi SMS gateway. Sign up, buy an SMS package,
# create an API key, then set SMS_ENABLED=true and fill the credentials below.
SMS_ENABLED=false
SMS_MSEGAT_USERNAME=
SMS_MSEGAT_API_KEY=
SMS_MSEGAT_SENDER=LAMAA

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
